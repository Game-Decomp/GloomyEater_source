[sub_resource type="GDScript" id=1]
script/source = "extends Node

onready var sound_players = [
	$\"1\", $\"2\", $\"3\", $\"4\"
]

func _ready():
	randomize()


func play():
	var index = randi()%4
	sound_players[index].stop()
	sound_players[index].play()
"

