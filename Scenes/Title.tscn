[sub_resource type="GDScript" id=1]
script/source = "extends Control

onready var masterText = $Options/option_Margin/VBoxContainer2/VBoxContainer/HBoxContainer3/lbl_master
onready var musicText = $Options/option_Margin/VBoxContainer2/VBoxContainer/HBoxContainer/lbl_music
onready var soundText = $Options/option_Margin/VBoxContainer2/VBoxContainer/HBoxContainer2/lbl_sound

var have_pressed = false

var MIN_DB = -40
var MAX_DB =   0

var master_volume:int setget set_master
var music_volume:int setget set_music
var sound_volume:int setget set_sound


func _ready():
	self.master_volume = convertDB2Volume(AudioServer.get_bus_volume_db(0))
	self.music_volume = convertDB2Volume(AudioServer.get_bus_volume_db(1))
	self.sound_volume = convertDB2Volume(AudioServer.get_bus_volume_db(2))
	
	SoundManager.play_music()
	
	if Globals.seen_ending:
		$Rumia.show()
	
	if not Globals.seen_title:
		Globals.seen_title = true
		self.music_volume = 85
		self.sound_volume = 75
	else:
		$Transition.show()
		$Transition.fade_out()
		yield(get_tree().create_timer(0.1),\"timeout\")
		$Rumia.mouth.frame = 2



func _on_btn_Start_pressed():
	if have_pressed:
		return
	
	have_pressed = true
	
	SoundManager.play_click()
	
	$Transition.show()
	$Transition.fade_in()
	yield(get_tree().create_timer(1.2),\"timeout\")
	get_tree().change_scene(\"res://Scenes/BaseProtoype.tscn\")


func _on_btn_options_pressed():
	SoundManager.play_click()
	$Title.hide()
	$Options.show()


func _on_btn_credits_pressed():
	SoundManager.play_click()
	$Title.hide()
	$Credits.show()


func _on_btn_master_down_pressed():
	SoundManager.play_click()
	self.master_volume -= 5


func _on_btn_master_up_pressed():
	SoundManager.play_click()
	self.master_volume += 5


func _on_btn_music_down_pressed():
	SoundManager.play_click()
	self.music_volume -= 5


func _on_btn_music_up_pressed():
	SoundManager.play_click()
	self.music_volume += 5


func _on_btn_sound_down_pressed():
	SoundManager.play_click()
	self.sound_volume -= 5


func _on_btn_sound_up_pressed():
	SoundManager.play_click()
	self.sound_volume += 5


func _on_btn_option_back_pressed():
	SoundManager.play_click()
	$Title.show()
	$Options.hide()


func _on_btn_title_pressed():
	SoundManager.play_click()
	$Title.show()
	$Credits.hide()


func convertDB2Volume(input):
	return range_lerp(input, MIN_DB, MAX_DB, 0, 100)


func convertVolume2DB(input):
	return range_lerp(input, 0, 100, MIN_DB, MAX_DB)


func set_master(volume):
	volume = clamp(volume, 0, 100)
	
	master_volume = volume
	AudioServer.set_bus_volume_db(0, range_lerp(volume, 0, 100, MIN_DB, MAX_DB))
	masterText.text = str(volume)


func set_music(volume):
	volume = clamp(volume, 0, 100)
	
	music_volume = volume
	AudioServer.set_bus_volume_db(1, range_lerp(volume, 0, 100, MIN_DB, MAX_DB))
	musicText.text = str(volume)


func set_sound(volume):
	volume = clamp(volume, 0, 100)
	
	sound_volume = volume
	AudioServer.set_bus_volume_db(2, range_lerp(volume, 0, 100, MIN_DB, MAX_DB))
	soundText.text = str(volume)


func _on_btn_exit_pressed():
	get_tree().quit()
"

