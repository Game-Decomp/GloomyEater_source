[sub_resource type="GDScript" id=48]
script/source = "extends Node2D

signal pet
signal stop

var isEntered:bool
var total_mouse_drag:float

var last_mouse_position:Vector2
var isPet = false

onready var emmitter = $PetParticle
onready var timer = $PetTimer

var hand_cursor = preload(\"res://FeedRumiaConcept/hand.png\")

func _physics_process(delta):
	var drag_length = 0 
	
	if isEntered and not Input.is_action_pressed(\"mouse_left\"):
		drag_length += (get_global_mouse_position() - last_mouse_position).length()
		total_mouse_drag += drag_length
	
	if total_mouse_drag > 800 and not isPet:
		emmitter.emitting = true
		isPet = true
		emit_signal(\"pet\")
	
	if isEntered and drag_length > 0 and isPet:
		timer.start()
	
	if isEntered and Input.is_action_just_pressed(\"mouse_left\"):
		Input.set_default_cursor_shape(Input.CURSOR_ARROW)
	
	if isEntered and Input.is_action_just_released(\"mouse_left\"):
		Input.set_custom_mouse_cursor(hand_cursor, Input.CURSOR_DRAG)
		Input.set_default_cursor_shape(Input.CURSOR_DRAG)
	
	last_mouse_position = get_global_mouse_position()


func _on_PetTimer_timeout():
	total_mouse_drag = 0
	emmitter.emitting = false
	isPet = false
	emit_signal(\"stop\")


func _on_PetArea_mouse_entered():
	isEntered = true
	if not Input.is_action_pressed(\"mouse_left\"):
		Input.set_custom_mouse_cursor(hand_cursor, Input.CURSOR_DRAG)
		Input.set_default_cursor_shape(Input.CURSOR_DRAG)


func _on_PetArea_mouse_exited():
	isEntered = false
	Input.set_default_cursor_shape(Input.CURSOR_ARROW)
