[sub_resource type="GDScript" id=5]
script/source = "extends Area2D

onready var desired_pos = $Position2D

var isMouseEntered = false

var meat = []


func _process(delta):
	if meat.size() == 0:
		return
	
	if Input.is_action_just_pressed(\"mouse_left\") and isMouseEntered:
		if meat.size() == 1:
			meat[0].isMouseEntered = true
			meat[0].isDrag = true
			meat[0].emit_signal(\"grabbed\", meat[0].isCooked)


func _on_EasyModo_body_entered(body):
	if body.collision_layer == collision_mask:
		meat.append(body)


func _on_EasyModo_body_exited(body):
	meat.erase(body)


func _on_EasyModo_mouse_entered():
	isMouseEntered = true


func _on_EasyModo_mouse_exited():
	isMouseEntered = false
"

