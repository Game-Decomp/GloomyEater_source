[sub_resource type="GDScript" id=8]
script/source = "extends Node


onready var angy_tween = $Tween

var isActivated = false


func the_crunch():
	SoundManager.play_crunch()


func _on_HungerBar_lose():
	if isActivated:
		return
	
	SoundManager.fade_out_music(3)
	
	isActivated = true
	
	$InputBlocker.show()
	$transition.show()
	get_parent().get_node(\"Final/btn_title\").hide()
	
	$AnimationPlayer.play(\"bad_end\")
	get_parent().get_node(\"Food\").drop_everything()
	get_parent().get_node(\"Rumia\").now_angy()
	
	var rumia = get_parent().get_node(\"Rumia\")
	
	angy_tween.interpolate_property(
		rumia, \"position\", 
		rumia.global_position, 
		Vector2(rumia.global_position.x, 321),
		3,
		Tween.TRANS_QUAD, Tween.EASE_IN_OUT)
	angy_tween.start()
	
	yield(get_tree().create_timer(3),\"timeout\")
	
	$transition.global_position = get_parent().get_node(\"Rumia/Base/Mouth/1\").global_position


func _on_AnimationPlayer_animation_finished(anim_name):
	yield(get_tree().create_timer(3),\"timeout\")
	get_tree().change_scene(\"res://Ending/BadEnd.tscn\")
"

[sub_resource type="Shader" id=9]
code = "shader_type canvas_item;
render_mode unshaded;

uniform sampler2D mask : hint_albedo;
uniform float threshold : hint_range(0.0, 1.0);

void fragment() {
	float alpha = step(threshold, texture(mask, UV).b);
	COLOR = vec4(0.0, 0.0, 0.0, alpha);
}"

