[sub_resource type="GDScript" id=1]
script/source = "extends Node2D

onready var timer = $Timer

const cloudScene = preload(\"res://Scenes/Cloud.tscn\")


func _ready():
	randomize()
	for _i in range(0, 5):
		var cloud = cloudScene.instance()
		cloud.global_position = Vector2(
			rand_range(0, 1000),
			rand_range(0,  200)
		)
		add_child(cloud)


func _on_Timer_timeout():
	var cloud = cloudScene.instance()
	cloud.global_position = Vector2(
		1000,
		rand_range(0, 200)
	)
	add_child(cloud)
	timer.start(rand_range(1, 60))
"

