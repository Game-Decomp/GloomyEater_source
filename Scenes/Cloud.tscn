[sub_resource type="GDScript" id=1]
script/source = "extends Node2D

onready var sprite = $Sprite

export var frame = 0 setget set_frame
export var speed = 5

const clouds = [
	preload(\"res://FeedRumiaConcept/Cloud1.PNG\"),
	preload(\"res://FeedRumiaConcept/Cloud2.PNG\"),
	preload(\"res://FeedRumiaConcept/Cloud3.PNG\"),
]

func _ready():
	self.frame = randi() % 3


func _process(delta):
	global_position.x -= speed * delta


func set_frame(val):
	frame = val
	
	sprite.texture = clouds[frame]


func _on_VisibilityNotifier2D_screen_exited():
	queue_free()
"

