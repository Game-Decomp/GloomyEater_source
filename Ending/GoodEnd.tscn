[sub_resource type="GDScript" id=1]
script/source = "extends Node

var have_pressed = false

func _ready():
	Globals.seen_ending = true
	
	$Transition.show()
	$Transition.fade_out()
	yield(get_tree().create_timer(1),\"timeout\")
	
	SoundManager.play_piano()
	$AnimationPlayer.play(\"end_sequence\")



func _on_btn_next_pressed():
	SoundManager.play_click()
	$CenterContainer.hide()
	$First_Next.hide()
	$DevNote.show()


func _on_btn_next2_pressed():
	SoundManager.play_click()
	$DevNote.hide()
	$Credits.show()


func _on_btn_title_pressed():
	if have_pressed:
		return
	
	have_pressed = true
	
	SoundManager.play_click()
	$Transition.fade_in()
	yield(get_tree().create_timer(1), \"timeout\")
	get_tree().change_scene(\"res://Scenes/Title.tscn\")
"

