margin_top = 59.0
margin_right = 720.0
margin_bottom = 446.0
custom_fonts/font = SubResource( 7 )
text = "Here it is! My third Touhou fan game. The aim for this game is to help people wind down and have fun. I'm glad that this time, I have a few friends who can help and support me. Thank you!

This game is heavily inspired by many Rumia games I've seen on Twitch streams. The Rumia games I saw there in my opinion are all cute, amazing, and wholesome. So I decided to also create one myself.

At first, I wanted to have Mystia to be the one cooking behind the stall. But, this idea will shape Rumia as the \"bad guy\". So, I scraped that idea out, and have Reimu take the stall.

P.S. Did you know you can headpat Rumia? (Don't make her cry!)"
align = 3
autowrap = true

