# Godot 3 recovered project - Gloomy Eater
# Keeps source code in git, keeps assets and builds out of it.

# ---- Imported binaries (regenerated by the editor on first open) ----
# .import/ holds the compiled .stex / .oggstr / .sample versions (~9 MB).
.import/

# ---- Raw game assets ----
*.png
*.jpg
*.jpeg
*.webp
*.svg
*.ico
*.ttf
*.otf
*.wav
*.mp3
*.ogg
*.stex
*.oggstr
*.mp3str
*.sample
*.png.import

# Audio embedded in an AudioStreamSample resource (~7 MB).
# Delete this line to keep the sizzle-loop sound in the repo.
Sound/Sizzle_Sound_lopp.tres

# ---- Editor-generated binary conversions (regenerated from .tscn/.tres) ----
.autoconverted/

# ---- Original recovered bytecode (not source) ----
*.gde
*.gdc
*.gd.remap
*.tscn.remap
*.tres.remap
*.res.import

# ---- Build output ----
../GloomyEater_build/
*.exe
*.apk
*.aab
*.idsig
*.pck
*.so
*.dll
bin/
build/

# ---- Export config: contains the keystore password, never commit ----
export_presets.cfg

# ---- Tooling / editor / OS junk ----
gdre_export.log
*.log
.godot/
.vs/
.idea/
__pycache__/
Thumbs.db
desktop.ini
.DS_Store
*.tmp
*.swp